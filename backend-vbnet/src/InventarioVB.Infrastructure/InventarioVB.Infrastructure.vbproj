<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>InventarioVB.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\InventarioVB.Application\InventarioVB.Application.vbproj" />
    <ProjectReference Include="..\InventarioVB.Domain\InventarioVB.Domain.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Data" />
    <Reference Include="System.Core" />
  </ItemGroup>

  <ItemGroup>
    <!--
      ⚠️ DEPENDENCIAS VULNERABLES INTENCIONALES (Snyk Open Source - NuGet)
        * Newtonsoft.Json 12.0.1           -> CVE-2024-21907 (DoS). Corregido en 13.0.1.
        * System.Text.Encodings.Web 4.5.0  -> CVE-2021-26701 (RCE). Corregido en 4.7.2 / 5.0.1.
    -->
    <PackageReference Include="Newtonsoft.Json" Version="12.0.1" />
    <PackageReference Include="System.Text.Encodings.Web" Version="4.5.0" />
  </ItemGroup>

</Project>
