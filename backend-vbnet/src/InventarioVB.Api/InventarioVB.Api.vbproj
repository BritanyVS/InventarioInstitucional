<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>InventarioVB.Api</RootNamespace>
    <StartupObject>InventarioVB.Api.Program</StartupObject>
    <AssemblyName>InventarioVB.Api</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\InventarioVB.Application\InventarioVB.Application.vbproj" />
    <ProjectReference Include="..\InventarioVB.Domain\InventarioVB.Domain.vbproj" />
    <ProjectReference Include="..\InventarioVB.Infrastructure\InventarioVB.Infrastructure.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNet.WebApi.OwinSelfHost" Version="5.2.9" />
    <PackageReference Include="Microsoft.AspNet.WebApi.Cors" Version="5.2.9" />
    <!-- Dependencia vulnerable intencional (Snyk Open Source). -->
    <PackageReference Include="Newtonsoft.Json" Version="12.0.1" />
  </ItemGroup>

</Project>
